// Restro — Prisma Schema
// Prod: PostgreSQL (DATABASE_URL="postgresql://...")

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

// OrderType: "DINE_IN" | "TAKEOUT" | "DELIVERY"
// OrderStatus: "PENDING" | "PREPARING" | "READY" | "DELIVERED" | "CANCELLED"
// StaffRole: "OWNER" | "MANAGER" | "WAITER" | "KITCHEN"
// SubscriptionStatus: "ACTIVE" | "CANCELLED" | "PAST_DUE" | "TRIAL" | "EXPIRED"
// BillingEventType: "PAYMENT_SUCCESS" | "PAYMENT_FAILED" | "PLAN_CHANGED" | "TRIAL_STARTED" | "TRIAL_ENDED" | "SUBSCRIPTION_CANCELLED" | "SUBSCRIPTION_RENEWED"

// ─── PLAN ─────────────────────────────────────────────────────────────────────

model Plan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  key         String  @unique // "STARTER" | "RESTRO_IA" | "BUSINESS"
  label       String // "Starter", "Restro IA", "Business"
  tag         String // "GRATIS", "PRO", "ENTERPRISE"
  description String?

  // Pricing (COP — integer, e.g. 49900 = $49.900)
  priceMonthly Int  @default(0)
  priceYearly  Int? // Descuento anual si aplica

  // Resource limits (-1 = unlimited)
  maxTables     Int @default(5)
  maxMenuItems  Int @default(20)
  maxStaff      Int @default(1)
  maxMenus      Int @default(1)
  analyticsDays Int @default(7)

  // Feature flags
  hasAI              Boolean @default(false)
  hasInventory       Boolean @default(false)
  hasMultiLanguage   Boolean @default(false)
  hasExportPDF       Boolean @default(false)
  hasExportExcel     Boolean @default(false)
  hasCustomBranding  Boolean @default(false)
  hasWhatsApp        Boolean @default(false)
  hasPrioritySupport Boolean @default(false)

  // Ordering & visibility
  sortOrder Int     @default(0)
  isActive  Boolean @default(true) // Visible on pricing page

  // Relations
  subscriptions Subscription[]
}

// ─── TENANT ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restaurant info
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  address     String?
  city        String?
  country       String  @default("CO")
  onboarding    Boolean @default(false)
  monthlyOrders String?

  // Social Links
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  websiteUrl   String?

  // Branding
  brandColor  String @default("#FF6B35")
  accentColor String @default("#1A1A2E")

  // Slug policy: editable freely first 30 days, then locked
  slugLockedAt  DateTime?
  slugChangedAt DateTime?

  // Settings
  isActive Boolean @default(true)
  timezone String  @default("America/Bogota")
  currency String  @default("COP")
  language String  @default("es")

  // Ordering Capabilities
  allowDineIn            Boolean @default(true)
  allowTakeout           Boolean @default(false)
  allowDelivery          Boolean @default(false)
  isMenuOnly             Boolean @default(false)
  requireTableQrForDineIn Boolean @default(true)
  allowWhatsAppOrdering  Boolean @default(false)
  whatsappNumber         String?

  // WhatsApp waitlist
  whatsappWaitlistEmail String?

  // Relations
  menus            Menu[]
  tables           Table[]
  orders           Order[]
  staff            StaffMember[]
  analyticsEvents  AnalyticsEvent[]
  orderTelemetry   OrderTelemetry[]
  subscription     Subscription?
  users            User[]
  featureOverrides TenantFeatureOverride[]
  businessHours    BusinessHour[]
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  name         String
  passwordHash String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role String @default("OWNER") // OWNER | MANAGER | WAITER | KITCHEN

  lastLoginAt DateTime?
}

// ─── BUSINESS HOURS ───────────────────────────────────────────────────────────

model BusinessHour {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime  String // HH:mm (e.g. "08:00")
  closeTime String // HH:mm (e.g. "17:00")

  @@index([tenantId])
}

// ─── MENU ─────────────────────────────────────────────────────────────────────

model Menu {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @default("Carta Principal")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  categories Category[]
}

model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  name        String
  description String?
  imageUrl    String?
  emoji       String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  items MenuItem[]
}

model MenuItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  price         Float // In COP (e.g., 15000.0)
  imageUrl      String? // Available on all plans
  isAvailable   Boolean @default(true)
  isHighlighted Boolean @default(false)
  sortOrder     Int     @default(0)

  // Nutritional / tags (future)
  tags String? // JSON array stored as string for SQLite compat

  orderItems     OrderItem[]
  modifierGroups MenuItemModifierGroup[]
}

model MenuItemModifierGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name          String // e.g. "Elige 1 Acompañamiento"
  isRequired    Boolean @default(false)
  minSelections Int     @default(0)
  maxSelections Int     @default(1)
  sortOrder     Int     @default(0)

  options MenuItemModifierOption[]
}

model MenuItemModifierOption {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String
  group   MenuItemModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String // e.g. "Papas a la Francesa"
  priceExtra  Float   @default(0) // Extra cost (COP)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)
}

// ─── TABLE ────────────────────────────────────────────────────────────────────

model Table {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String // e.g., "Mesa 1", "Terraza 3", "Barra"
  qrToken   String  @unique @default(cuid()) // Stable token for QR (survives slug change)
  capacity  Int?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]
}

// ─── ORDER ────────────────────────────────────────────────────────────────────

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Order type
  type String @default("DINE_IN") // DINE_IN | TAKEOUT | DELIVERY

  // For DINE_IN
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])

  // For TAKEOUT & DELIVERY
  customerName  String?
  customerPhone String?

  // For DELIVERY only
  deliveryAddress String?
  deliveryNotes   String?

  // Status
  status String @default("PENDING") // PENDING | PREPARING | READY | DELIVERED | CANCELLED

  // Financial snapshot
  subtotal Float @default(0)
  total    Float @default(0)

  // Notes
  notes String?

  // SLA & Priority
  isPriority            Boolean @default(false)
  targetPrepTimeMinutes Int     @default(12)
  incidentNote          String?

  // Lifecycle Milestones & Operational Timestamps
  preparingAt            DateTime?
  readyAt                DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  actualPrepTimeSeconds  Int?
  actualTotalTimeSeconds Int?
  wasSlaBreached         Boolean   @default(false)
  cancellationReason     String?

  // Order number (human-readable, per-tenant sequential)
  orderNumber Int

  // Items & Relations
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  telemetry     OrderTelemetry?
}

model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  // Snapshot at time of order (price may change later)
  name     String
  price    Float
  quantity Int     @default(1)
  notes    String? // Per-item notes ("sin cebolla", "bien cocido")
  status   String  @default("PENDING") // PENDING | PREPARING | READY
  station  String? // Cocina | Parrilla | Fritura | Bebidas | Postres | Despacho

  // Cooking Timestamps & Metrics per Item
  preparingAt     DateTime?
  readyAt         DateTime?
  prepTimeSeconds Int?

  // JSON array of selected modifiers: [{ optionId: string, name: string, priceExtra: number, groupId: string, groupName: string }]
  modifiersJson String?

  subtotal Float // (price + sum(priceExtra)) * quantity
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus  String?
  toStatus    String
  changedById String? // Staff user ID who changed the status
  note        String?
}

// ─── TELEMETRY & AI ANALYTICS ──────────────────────────────────────────────────

model OrderTelemetry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Temporal AI Features
  hourOfDay Int // 0 - 23
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday

  // Kitchen Load Metrics at Creation Time
  activeOrdersCountAtCreation    Int @default(0)
  preparingOrdersCountAtCreation Int @default(0)

  // Order Metrics
  totalItemQuantity Int     @default(1)
  uniqueItemCount   Int     @default(1)
  hasModifiers      Boolean @default(false)
  channelSource     String  @default("QR_DINE_IN") // QR_DINE_IN | WAITER | WHATSAPP | TAKEOUT | DELIVERY

  @@index([tenantId])
  @@index([createdAt])
}

// ─── STAFF ────────────────────────────────────────────────────────────────────

model StaffMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  email    String
  role     String // OWNER | MANAGER | WAITER | KITCHEN
  isActive Boolean @default(true)

  @@unique([tenantId, email])
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  event     String // "menu_view" | "item_view" | "order_started" | "order_completed" | etc.
  data      String? // JSON payload
  sessionId String? // Anonymous session identifier
  userAgent String?
}

// ─── SUBSCRIPTION ─────────────────────────────────────────────────────────────

model Subscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Plan reference (FK — source of truth)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Status
  status String @default("ACTIVE") // ACTIVE | CANCELLED | PAST_DUE | TRIAL | EXPIRED

  // Billing cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Trial
  trialEndsAt DateTime?

  // Cancellation
  cancelledAt  DateTime?
  cancelReason String?

  // Payment provider (Wompi)
  wompiSubscriptionId String?
  wompiCustomerId     String?

  // Relations
  billingEvents BillingEvent[]
}

// ─── BILLING EVENT ────────────────────────────────────────────────────────────

model BillingEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Event type
  type String // PAYMENT_SUCCESS | PAYMENT_FAILED | PLAN_CHANGED | TRIAL_STARTED | TRIAL_ENDED | SUBSCRIPTION_CANCELLED | SUBSCRIPTION_RENEWED

  // Financial
  amount   Int? // En COP (integer, e.g. 49900)
  currency String @default("COP")

  // Plan change tracking
  fromPlanId String?
  toPlanId   String?

  // Provider reference
  wompiTransactionId String?

  // Metadata
  metadata String? // JSON for extra data
  note     String?
}

// ─── TENANT FEATURE OVERRIDE ──────────────────────────────────────────────────

model TenantFeatureOverride {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feature   String // "hasAI" | "maxTables" | etc.
  value     String // "true" | "50" — parsed by app code based on feature type
  reason    String? // "Promoción lanzamiento" | "Override manual"
  expiresAt DateTime?

  @@unique([tenantId, feature])
}
